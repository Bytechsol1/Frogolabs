# Copy this file to .env for local development:
#   cp .env.example .env
# .env is gitignored and must never be committed.

# --- Database (local dev via `docker compose up -d` from the repo root) ---
DATABASE_URL="postgresql://frigoflow:frigoflow_dev_password@localhost:5432/frigoflow?schema=public"
DIRECT_URL="postgresql://frigoflow:frigoflow_dev_password@localhost:5432/frigoflow?schema=public"

# --- Auth ---
# Any long random string works for local dev. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="dev-only-change-me"

# --- Server ---
# Must match frontend/.env.local's BACKEND_URL (defaults to 3001 if unset).
PORT=3001
NODE_ENV=development
# Comma-separated exact browser origins. Set your actual live frontend origin.
# Localhost:3000 and 127.0.0.1:3000 are also allowed outside production.
# Example: CORS_ORIGINS=https://your-frigo-flow.vercel.app
CORS_ORIGINS=

# --- Terra Vantage (Blood Labs) ---
# From the Terra dashboard, under your Vantage API credentials.
TERRA_DEV_ID=
TERRA_API_KEY=
# Terra webhook signing secret, shown in the Terra dashboard. Required to
# verify the authenticity of incoming POST /api/v1/terra/webhook requests.
TERRA_SIGNING_SECRET=
# Local sandbox demo only. Creates a real Terra sandbox order for the selected
# test on patient creation and simulates results after five minutes. Disabled in production.
TERRA_SANDBOX_AUTO_REPORTS=true
# Read-only Terra reconciliation every minute, in addition to signed webhooks.
TERRA_WORKFLOW_AUTO_SYNC=true

# --- Mail (required for clinic registration) ---
# Gmail SMTP: SMTP_USER is the full sender Gmail address;
# SMTP_PASS is a Google App Password (requires 2-Step Verification).
# Verification emails go to the email entered by the registering clinic.
# Missing credentials or failed delivery return an error, never a successful send.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

SMTP_SECURE=false

SMTP_FROM_NAME=Frigo Flow

SMTP_FROM_EMAIL=
TERRA_ENVIRONMENT=sandbox
TERRA_REQUIRE_LIVE_DATA=false

TERRA_SHOW_SANDBOX_DATA=true
