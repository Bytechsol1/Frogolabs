# Copy this file to .env.local for local development:
#   cp .env.local.example .env.local
# .env.local is gitignored and must never be committed.

# Required server-only origin for /api/* and /uploads/* (see next.config.ts).
# Local development:
BACKEND_URL=http://localhost:3001
# Live frontend: set BACKEND_URL=https://YOUR-NGROK-HOST in the hosting dashboard,
# then rebuild/redeploy. No /api/v1 suffix. Never put server keys in NEXT_PUBLIC_*.

# Optional hostnames when exposing the Next.js development server itself.
# Not needed when only the NestJS backend is exposed through ngrok.
DEV_ALLOWED_ORIGINS=

# Optional server-only SMTP delivery for the backend on Render Free.
# The same private MAIL_BRIDGE_SECRET must be set on Render. Never use NEXT_PUBLIC_.
# See docs/email-verification.md. Keep these blank when using direct backend SMTP.
MAIL_BRIDGE_SECRET=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=
SMTP_FROM_EMAIL=
